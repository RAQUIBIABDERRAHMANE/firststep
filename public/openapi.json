{
  "openapi": "3.1.0",
  "info": {
    "title": "FirstStep API",
    "description": "API for FirstStep B2B SaaS Platform in Morocco. It supports multi-tenant restaurant and cabinet services, file uploads, and real-time SSE streams.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Current Host Server"
    }
  ],
  "paths": {
    "/api/upload": {
      "post": {
        "summary": "Upload a file",
        "description": "Uploads an image or document to the server. Access is restricted to users with the ADMIN role.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The file to upload"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "url": {
                      "type": "string"
                    },
                    "filename": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "No file uploaded"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Failed to save file"
          }
        }
      }
    },
    "/api/tenant/{tenantSlug}/orders/{orderId}/stream": {
      "get": {
        "summary": "Stream order status updates",
        "description": "Establishes a Server-Sent Events (SSE) stream to receive live updates of a restaurant order's status.",
        "parameters": [
          {
            "name": "tenantSlug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier slug for the tenant restaurant"
          },
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier ID of the order"
          }
        ],
        "responses": {
          "200": {
            "description": "SSE status stream. Closes automatically when status becomes terminal (SERVED, PAID, CANCELED).",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "PENDING",
                        "PREPARING",
                        "READY",
                        "SERVED",
                        "PAID",
                        "CANCELED",
                        "NOT_FOUND"
                      ]
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Get system health status",
        "description": "Verifies that the application server and the database connection are fully operational.",
        "responses": {
          "200": {
            "description": "System is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "healthy"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "database": {
                      "type": "string",
                      "example": "connected"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "System is unhealthy due to a database connection or other critical dependency failure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "unhealthy"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
