generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String
  companyName      String
  role             String            @default("CLIENT")
  createdAt        DateTime          @default(now())
  chatSessions     ChatSession[]
  notifications    Notification[]
  paymentRequests  PaymentRequest[]
  emailListMembers EmailListMember[]
  websites         TenantWebsite[]
  services         UserService[]
  unsubscribed     Boolean           @default(false)
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Service {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  status          String           @default("COMING_SOON")
  category        String?
  createdAt       DateTime         @default(now())
  icon            String?
  price           Float?
  paymentRequests PaymentRequest[]
  websites        TenantWebsite[]
  users           UserService[]
}

model UserService {
  id         String   @id @default(cuid())
  userId     String
  serviceId  String
  notify     Boolean  @default(false)
  selectedAt DateTime @default(now())
  isActive   Boolean  @default(true)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model TenantWebsite {
  id                  String                  @id @default(cuid())
  slug                String                  @unique
  userId              String
  serviceId           String
  siteName            String
  description         String?
  logo                String?
  coverImage          String?
  primaryColor        String                  @default("#3B82F6")
  config              String                  @default("{}")
  designTemplate      String                  @default("classic")
  isActive            Boolean                 @default(false)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  cabinetAppointments CabinetAppointment[]
  cabinetClients      CabinetClient[]
  cabinetServices     CabinetService[]
  categories          RestaurantCategory[]
  tables              RestaurantTable[]
  waiters             RestaurantWaiter[]
  reports             RestaurantReport[]
  reservations        RestaurantReservation[]
  invoices            Invoice[]
  invoiceSettings     InvoiceSettings?
  service             Service                 @relation(fields: [serviceId], references: [id])
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([userId])
}

model RestaurantCategory {
  id       String           @id @default(cuid())
  tenantId String
  name     String
  order    Int              @default(0)
  isActive Boolean          @default(true)
  tenant   TenantWebsite    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dishes   RestaurantDish[]

  @@index([tenantId])
}

model RestaurantDish {
  id          String             @id @default(cuid())
  categoryId  String
  name        String
  description String?
  price       Float
  image       String?
  isActive    Boolean            @default(true)
  order       Int                @default(0)
  category    RestaurantCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model RestaurantTable {
  id       String            @id @default(cuid())
  tenantId String
  number   String
  capacity Int?
  isActive Boolean           @default(true)
  waiterId String?
  orders   RestaurantOrder[]
  waiter   RestaurantWaiter? @relation(fields: [waiterId], references: [id])
  tenant   TenantWebsite     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([waiterId])
}

model RestaurantWaiter {
  id        String            @id @default(cuid())
  tenantId  String
  name      String
  pin       String
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  tables    RestaurantTable[]
  tenant    TenantWebsite     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model RestaurantOrder {
  id          String                @id @default(cuid())
  tableId     String
  status      String                @default("PENDING")
  totalAmount Float
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  table       RestaurantTable       @relation(fields: [tableId], references: [id])
  items       RestaurantOrderItem[]

  @@index([tableId])
}

model RestaurantOrderItem {
  id       String          @id @default(cuid())
  orderId  String
  dishId   String
  name     String
  price    Float
  quantity Int
  order    RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model RestaurantReport {
  id        String        @id @default(cuid())
  tenantId  String
  month     Int
  year      Int
  status    String        @default("GENERATED")
  language  String        @default("fr")
  data      String
  createdAt DateTime      @default(now())
  tenant    TenantWebsite @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month, year])
  @@index([tenantId])
}

model RestaurantReservation {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  phone     String
  email     String?
  date      DateTime
  time      String
  partySize Int
  notes     String?
  status    String        @default("PENDING")
  createdAt DateTime      @default(now())
  tenant    TenantWebsite @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([date])
}

model CabinetService {
  id           String               @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  price        Float
  duration     Int
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  appointments CabinetAppointment[]
  tenant       TenantWebsite        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CabinetClient {
  id             String               @id @default(cuid())
  tenantId       String
  name           String
  email          String?
  phone          String?
  notes          String?
  age            Int?
  cni            String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  appointments   CabinetAppointment[]
  invoices       Invoice[]
  medicalRecords MedicalRecord[]
  medicalHistory MedicalHistory[]
  tenant         TenantWebsite        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([email])
}

model CabinetAppointment {
  id              String         @id @default(cuid())
  tenantId        String
  serviceId       String
  clientId        String
  appointmentDate DateTime
  status          String         @default("SCHEDULED")
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  tenant          TenantWebsite  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          CabinetClient  @relation(fields: [clientId], references: [id])
  service         CabinetService @relation(fields: [serviceId], references: [id])

  @@index([tenantId])
  @@index([serviceId])
  @@index([clientId])
  @@index([appointmentDate])
}

model PaymentRequest {
  id                String    @id @default(cuid())
  userId            String
  serviceId         String
  amount            Float
  status            String    @default("PENDING")
  transferReference String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime
  confirmedAt       DateTime?
  confirmedBy       String?
  service           Service   @relation(fields: [serviceId], references: [id])
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([serviceId])
  @@index([status])
}

model BankAccount {
  id          String   @id @default(cuid())
  accountName String
  iban        String
  bic         String?
  bankName    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  rib         String?
}

model Campaign {
  id                 String    @id @default(cuid())
  subject            String
  content            String
  status             String    @default("DRAFT")
  sentAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  recipientCount     Int       @default(0)
  successCount       Int       @default(0)
  failureCount       Int       @default(0)
  selectedRecipients String    @default("[]")
  emailListIds       String    @default("[]")
  scheduledAt        DateTime?
  attachments        String?   @default("[]")
}

model EmailList {
  id          String            @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     EmailListMember[]
}

model EmailListMember {
  id           String    @id @default(cuid())
  listId       String
  list         EmailList @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String?
  name         String?
  createdAt    DateTime  @default(now())
  unsubscribed Boolean   @default(false)

  @@unique([listId, userId])
  @@unique([listId, email])
}

model InvoiceSettings {
  id             String        @id @default(cuid())
  tenantId       String        @unique
  companyName    String?
  companyAddress String?
  companyPhone   String?
  companyEmail   String?
  companyLogo    String?
  taxRate        Float         @default(0)
  currency       String        @default("MAD")
  prefix         String        @default("FAC")
  nextNumber     Int           @default(1)
  footerNote     String?
  bankDetails    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         TenantWebsite @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String         @id @default(cuid())
  tenantId      String
  clientId      String?
  number        String
  status        String         @default("DRAFT")
  issueDate     DateTime       @default(now())
  dueDate       DateTime?
  subtotal      Float          @default(0)
  taxRate       Float          @default(0)
  taxAmount     Float          @default(0)
  total         Float          @default(0)
  notes         String?
  clientName    String
  clientEmail   String?
  clientPhone   String?
  clientAddress String?
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tenant        TenantWebsite  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        CabinetClient? @relation(fields: [clientId], references: [id])
  items         InvoiceItem[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([clientId])
  @@index([status])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  total       Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model MedicalRecord {
  id             String         @id @default(cuid())
  tenantId       String
  clientId       String
  visitDate      DateTime       @default(now())
  chiefComplaint String?
  diagnosis      String?
  treatment      String?
  notes          String?
  weight         Float?
  bloodPressure  String?
  temperature    Float?
  heartRate      Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  client         CabinetClient  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  prescriptions  Prescription[]

  @@index([tenantId])
  @@index([clientId])
  @@index([visitDate])
}

model Prescription {
  id              String        @id @default(cuid())
  medicalRecordId String
  medication      String
  dosage          String?
  frequency       String?
  duration        String?
  instructions    String?
  createdAt       DateTime      @default(now())
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)

  @@index([medicalRecordId])
}

model MedicalHistory {
  id        String        @id @default(cuid())
  clientId  String
  condition String
  since     String?
  status    String        @default("ACTIVE")
  notes     String?
  createdAt DateTime      @default(now())
  client    CabinetClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}
